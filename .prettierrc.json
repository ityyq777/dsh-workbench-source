{
  // JSON5 支持注释，Prettier 会自动发现此配置。未列出的选项沿用工具默认值。
  // 这里只控制排版；删除未使用的 import 请运行 pnpm lint:fix。
  // 目标行宽为 120 字符，并非硬性上限；长字符串或 URL 仍可能超过此宽度。
  "printWidth": 120,
  // 在语句末尾输出分号，减少对 JavaScript 自动分号插入规则的依赖。
  "semi": true,
  // JS/TS 字符串优先使用双引号；另一种引号能减少转义时可能例外。
  // JSX 属性引号由独立的 jsxSingleQuote 选项决定，不受此项控制。
  "singleQuote": false,
  // 在语法允许的多行结构末尾加逗号，减少增删最后一项时的 diff。
  // 包括对象、数组和函数参数/实参；不会给单行结构强行添加尾逗号。
  // 函数参数尾逗号需要 ES2017 支持，本项目使用现代 Node.js。
  "trailingComma": "all"
}