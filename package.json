{
  "name": "dsh-workbench-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter @wb/core --filter @wb/sdk --filter dsh-workbench build && node scripts/build-addon-clients.mjs",
    "build:clients": "node scripts/build-addon-clients.mjs",
    "cloud:update": "git submodule update --remote --merge cloud",
    "cloud:build": "mvn -f cloud/pom.xml -DskipTests package",
    "dist:shell": "node scripts/dist-shell.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:workspace-stats": "node scripts/test-workspace-stats.mjs",
    "test:claim": "node scripts/test-task-claim.mjs && node scripts/test-task-claim-ui.mjs",
    "test:task-publisher": "node scripts/test-task-publisher.mjs",
    "test:commands": "node scripts/test-tasks-commands.mjs",
    "test:workspace-view": "node scripts/test-tasks-workspace-view.mjs",
    "test:workspace-filter": "node scripts/test-task-workspace-filter.mjs",
    "test:ownership-backend": "node scripts/test-task-ownership-backend.mjs",
    "test:ownership-concurrency": "node scripts/test-task-ownership-concurrency.mjs",
    "test:ownership-ui": "node scripts/test-task-ownership-ui.mjs",
    "test:ownership-host": "node scripts/test-ownership-host.mjs",
    "test:tasks-review": "node scripts/test-tasks-review.mjs",
    "test:task-difficulty": "node scripts/test-task-difficulty-backend.mjs && node scripts/test-tasks-difficulty-ui.mjs",
    "test:task-presets": "node scripts/test-task-presets.mjs",
    "test:tasks-search": "node scripts/test-tasks-search.mjs",
    "test:task-body": "node scripts/test-task-body.mjs",
    "test:task-body-react": "node scripts/test-task-body-react.mjs",
    "test:task-config-ui": "node scripts/test-task-config-ui.mjs",
    "test:markdown-performance": "node scripts/test-markdown-performance.mjs",
    "test:tasks-restart": "node scripts/test-tasks-restart.mjs",
    "test:tasks-restart-client": "node scripts/test-tasks-restart-client.mjs",
    "test:storage-visual": "node scripts/test-storage-visual.mjs",
    "test:clients": "node scripts/test-clients.mjs",
    "test:task-stats-bars": "node scripts/test-task-stats-bars-ui.mjs",
    "test:addon-actions": "node scripts/test-addon-action-schema-view.mjs",
    "test:action-schema": "node scripts/test-addon-action-schema-actions.mjs && node scripts/test-addon-action-schema-view.mjs",
    "test:schema": "node scripts/test-shell-schema-endpoint.mjs",
    "preview:actions": "node scripts/actions-ui-preview.mjs",
    "test:view-icons": "node packages/shell/client/view-tabs.test.mjs && node packages/shell/client/view-tabs.test.mjs --bundle",
    "test:timeline": "node scripts/test-timeline-stats.mjs",
    "test:workspaces": "node scripts/test-workspaces.mjs",
    "test:tags": "node scripts/test-tags.mjs",
    "test:tags-ui": "node scripts/test-tags-ui.mjs",
    "test:sites": "node scripts/test-sites.mjs",
    "test:node-overview": "node scripts/test-node-overview.mjs",
    "test:site-node-description": "node scripts/test-site-node-description.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "test:storage-cards": "node scripts/test-storage-cards.mjs",
    "test:storage-bulk": "node scripts/test-storage-bulk.mjs",
    "test:storage-selection": "node scripts/test-storage-selection.mjs",
    "test:config": "node scripts/test-config.mjs",
    "test:data": "node scripts/test-data.mjs",
    "test:data-ui": "node scripts/test-data-ui.mjs",
    "test:nodeps": "node scripts/test-nodeps.mjs",
    "test:backup": "node scripts/test-backup.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "stage:release": "node scripts/stage-release.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:github": "node scripts/publish-github.mjs",
    "test:audit": "node scripts/test-audit.mjs",
    "test:profile-sync": "node scripts/test-check-profile-sync.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "audit:lines": "node scripts/audit-lines.mjs",
    "audit:profile": "node scripts/check-profile-sync.mjs",
    "audit:structure": "node scripts/audit-structure.mjs",
    "test:structure": "node scripts/test-structure.mjs",
    "test:shell-immersive": "node scripts/test-shell-immersive.mjs",
    "verify:standalone": "node scripts/verify-standalone-install.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-unused-imports": "^4.4.1",
    "lucide-react": "^1.70.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.9.3"
  }
}
