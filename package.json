{
  "name": "dsh-workbench-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter @wb/core --filter @wb/sdk --filter dsh-workbench build && node scripts/build-addon-clients.mjs",
    "build:clients": "node scripts/build-addon-clients.mjs",
    "cloud:update": "git submodule update --remote --merge cloud",
    "cloud:build": "mvn -f cloud/pom.xml -DskipTests package",
    "dist:shell": "node scripts/dist-shell.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:clients": "node scripts/test-clients.mjs",
    "test:tags": "node scripts/test-tags.mjs",
    "test:tags-ui": "node scripts/test-tags-ui.mjs",
    "test:sites": "node scripts/test-sites.mjs",
    "test:config": "node scripts/test-config.mjs",
    "test:backup": "node scripts/test-backup.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "stage:release": "node scripts/stage-release.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:github": "node scripts/publish-github.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lucide-react": "^1.70.0"
  }
}
