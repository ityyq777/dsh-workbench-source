{
  "name": "dsh-workbench-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter @wb/core --filter @wb/sdk --filter dsh-workbench build && node scripts/build-addon-clients.mjs",
    "build:clients": "node scripts/build-addon-clients.mjs",
    "cloud:update": "git submodule update --remote --merge cloud",
    "cloud:build": "mvn -f cloud/pom.xml -DskipTests package",
    "dist:shell": "node scripts/dist-shell.mjs",
    "test:native": "node scripts/test-native.mjs",
    "test:tasks-review": "node scripts/test-tasks-review.mjs",
    "test:tasks-restart": "node scripts/test-tasks-restart.mjs",
    "test:tasks-restart-client": "node scripts/test-tasks-restart-client.mjs",
    "test:storage-visual": "node scripts/test-storage-visual.mjs",
    "test:clients": "node scripts/test-clients.mjs",
    "test:view-icons": "node packages/shell/client/view-tabs.test.mjs && node packages/shell/client/view-tabs.test.mjs --bundle",
    "test:tags": "node scripts/test-tags.mjs",
    "test:tags-ui": "node scripts/test-tags-ui.mjs",
    "test:sites": "node scripts/test-sites.mjs",
    "test:node-overview": "node scripts/test-node-overview.mjs",
    "test:site-node-description": "node scripts/test-site-node-description.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "test:storage-cards": "node scripts/test-storage-cards.mjs",
    "test:storage-bulk": "node scripts/test-storage-bulk.mjs",
    "test:storage-selection": "node scripts/test-storage-selection.mjs",
    "test:config": "node scripts/test-config.mjs",
    "test:data": "node scripts/test-data.mjs",
    "test:data-ui": "node scripts/test-data-ui.mjs",
    "test:nodeps": "node scripts/test-nodeps.mjs",
    "test:backup": "node scripts/test-backup.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "stage:release": "node scripts/stage-release.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "publish:github": "node scripts/publish-github.mjs",
    "test:audit": "node scripts/test-audit.mjs",
    "audit:lines": "node scripts/audit-lines.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lucide-react": "^1.70.0"
  }
}
