{
  "name": "dsh-workbench-tags",
  "version": "1.3.1",
  "description": "个人工作台标签插件：创建与管理标签，为站点等业务提供标签归类",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json"
  ],
  "wb": {
    "addon": {
      "id": "wb-addon-tags",
      "title": "标签",
      "description": "创建与管理标签，为站点等业务提供标签归类",
      "version": "1.3.1",
      "minShell": "0.5.0",
      "tables": [
        "tag",
        "tag_mapping"
      ],
      "views": [
        "tags"
      ],
      "toolActions": [
        "tags.list",
        "tags.search",
        "tags.create",
        "tags.delete",
        "tags.byIds",
        "tags.link",
        "tags.unlink",
        "tags.itemsOf"
      ],
      "client": "lib/client.js"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dsh-workbench": "file:../../shell-dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-workbench"
      ]
    }
  }
}
