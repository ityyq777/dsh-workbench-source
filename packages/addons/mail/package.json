{
  "name": "dsh-workbench-mail",
  "version": "0.1.0",
  "description": "个人工作台邮件：IMAP 收信头、SMTP 发信、保险箱托管密码",
  "type": "module",
  "main": "lib/index.js",
  "files": ["lib", "cordis.patch.yml", "package.json"],
  "license": "MIT",
  "wb": {
    "addon": {
      "id": "wb-addon-mail",
      "title": "邮件",
      "version": "0.1.0",
      "minShell": "0.6.7",
      "tables": ["mail_account", "mail_mailbox", "mail_message", "mail_attachment"],
      "views": ["messages", "compose", "accounts", "data", "actions"],
      "toolActions": ["mail.status", "mail.accountList", "mail.accountCreate", "mail.accountUpdate", "mail.accountDelete", "mail.accountTest", "mail.mailboxList", "mail.mailboxSync", "mail.messageList", "mail.messageGet", "mail.messageSend", "mail.messageMarkRead", "mail.messageMove", "mail.messageDelete", "mail.sync", "mail.dataTables", "mail.dataQuery", "mail.actionSchema"],
      "client": "lib/client.js"
    }
  },
  "dependencies": { "dsh-workbench": "file:../../shell-dist" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "inject": ["dsh-workbench"] } }
}
