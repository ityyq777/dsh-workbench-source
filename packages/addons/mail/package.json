{
  "name": "dsh-workbench-mail",
  "version": "0.4.5",
  "description": "个人工作台邮件：安全 IMAP 收信、文件夹与已读同步、附件按需下载、草稿与 SMTP 回复转发",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json"
  ],
  "license": "MIT",
  "wb": {
    "addon": {
      "id": "wb-addon-mail",
      "title": "邮件",
      "version": "0.4.5",
      "minShell": "0.8.0",
      "tables": [
        "mail_account",
        "mail_mailbox",
        "mail_message",
        "mail_attachment"
      ],
      "views": [
        "messages",
        "compose",
        "accounts",
        "data",
        "actions"
      ],
      "toolActions": [
        "mail.status",
        "mail.accountList",
        "mail.accountCreate",
        "mail.accountUpdate",
        "mail.accountDelete",
        "mail.accountTest",
        "mail.mailboxList",
        "mail.mailboxSync",
        "mail.messageList",
        "mail.messageGet",
        "mail.messageBody",
        "mail.messageSend",
        "mail.messageMarkRead",
        "mail.messageMove",
        "mail.messageDelete",
        "mail.sync",
        "mail.dataTables",
        "mail.dataQuery",
        "mail.providerList",
        "mail.accountProbe",
        "mail.attachmentDownload",
        "mail.draftGet",
        "mail.draftList",
        "mail.draftSave",
        "mail.draftDelete",
        "mail.actionSchema"
      ],
      "client": "lib/client.js"
    }
  },
  "dependencies": {
    "dsh-workbench": "file:../../shell-dist",
    "dsh-workbench-vault": "file:../vault"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-workbench"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
