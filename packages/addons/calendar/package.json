{
  "name": "dsh-workbench-calendar",
  "version": "0.1.0",
  "description": "个人工作台日历：本地日历、事件、参与人与提醒",
  "type": "module",
  "main": "lib/index.js",
  "files": ["lib", "cordis.patch.yml", "package.json"],
  "license": "MIT",
  "wb": {
    "addon": {
      "id": "wb-addon-calendar",
      "title": "日历",
      "version": "0.1.0",
      "minShell": "0.6.7",
      "tables": ["calendar", "calendar_event", "calendar_attendee", "calendar_reminder"],
      "views": ["events", "calendars", "config", "data", "actions"],
      "toolActions": ["calendar.status", "calendar.stats", "calendar.calendarList", "calendar.calendarCreate", "calendar.calendarUpdate", "calendar.calendarDelete", "calendar.eventsBetween", "calendar.eventGet", "calendar.eventCreate", "calendar.eventUpdate", "calendar.eventDelete", "calendar.eventRemind", "calendar.dataTables", "calendar.dataQuery", "calendar.actionSchema"],
      "client": "lib/client.js"
    }
  },
  "dependencies": { "dsh-workbench": "file:../../shell-dist" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "inject": ["dsh-workbench"] } }
}
