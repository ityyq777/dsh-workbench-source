{
  "name": "dsh-workbench-contacts",
  "version": "0.1.0",
  "description": "个人工作台联系人：本地联系人、分组、多值字段与 vCard 导入导出",
  "type": "module",
  "main": "lib/index.js",
  "files": ["lib", "cordis.patch.yml", "package.json"],
  "license": "MIT",
  "wb": {
    "addon": {
      "id": "wb-addon-contacts",
      "title": "联系人",
      "version": "0.1.0",
      "minShell": "0.6.7",
      "tables": ["contact", "contact_group", "contact_field", "contact_group_member"],
      "views": ["contacts", "groups", "importExport", "config", "data", "actions"],
      "toolActions": ["contacts.status", "contacts.list", "contacts.get", "contacts.create", "contacts.update", "contacts.delete", "contacts.search", "contacts.groupList", "contacts.groupCreate", "contacts.groupDelete", "contacts.importVcf", "contacts.exportVcf", "contacts.dataTables", "contacts.dataQuery", "contacts.actionSchema"],
      "client": "lib/client.js"
    }
  },
  "dependencies": { "dsh-workbench": "file:../../shell-dist" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "inject": ["dsh-workbench"] } }
}
