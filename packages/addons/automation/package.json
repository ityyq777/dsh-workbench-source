{
  "name": "dsh-workbench-automation",
  "version": "0.1.0",
  "description": "个人工作台自动化：定时/域事件/手动触发白名单 action，含模板、条件、限频与运行记录",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json"
  ],
  "license": "MIT",
  "wb": {
    "addon": {
      "id": "wb-addon-automation",
      "title": "自动化",
      "version": "0.1.0",
      "minShell": "0.6.7",
      "tables": [
        "automation_rule",
        "automation_run",
        "automation_meta"
      ],
      "views": [
        "stats",
        "rules",
        "runs",
        "config",
        "data",
        "actions"
      ],
      "toolActions": [
        "automation.status",
        "automation.ruleList",
        "automation.ruleGet",
        "automation.ruleCreate",
        "automation.ruleUpdate",
        "automation.ruleDelete",
        "automation.ruleRun",
        "automation.runList",
        "automation.runGet",
        "automation.stats",
        "automation.configGet",
        "automation.configSet",
        "automation.actionOptions",
        "automation.actionSchema",
        "automation.dataTables",
        "automation.dataQuery"
      ],
      "client": "lib/client.js"
    }
  },
  "dependencies": {
    "dsh-workbench": "file:../../shell-dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-workbench"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
