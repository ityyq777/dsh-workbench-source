{
  "name": "dsh-workbench-sites",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "个人工作台站点插件：目录树、链接与标签",
  "main": "lib/index.js",
  "wb": {
    "addon": {
      "id": "wb-addon-sites",
      "title": "站点",
      "description": "站点收藏：目录树、链接与标签",
      "version": "1.3.2",
      "minShell": "0.5.0",
      "tables": [
        "site",
        "site_node",
        "site_node_mapping",
        "tag_mapping"
      ],
      "views": [
        "sites"
      ],
      "toolActions": [
        "sites.capabilities",
        "sites.list",
        "sites.get",
        "sites.create",
        "sites.update",
        "sites.delete",
        "sites.stats",
        "siteTags.search",
        "siteTags.byIds",
        "siteNodes.tree",
        "siteNodes.children",
        "siteNodes.multipleChildren",
        "siteNodes.pathChildren",
        "siteNodes.path",
        "siteNodes.create",
        "siteNodes.rename",
        "siteNodes.move",
        "siteNodes.delete"
      ],
      "client": "lib/client.js"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dsh-workbench": "file:../../shell-dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-workbench"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json"
  ]
}
