{
  "name": "dsh-workbench-connector",
  "version": "0.1.0",
  "description": "个人工作台连接器：RSS/Webhook 内容接入，来源定义可同步、凭据本机",
  "type": "module",
  "main": "lib/index.js",
  "files": ["lib", "cordis.patch.yml", "package.json"],
  "license": "MIT",
  "wb": {
    "addon": {
      "id": "wb-addon-connector",
      "title": "连接器",
      "version": "0.1.0",
      "minShell": "0.6.7",
      "tables": ["connector_source", "connector_source_state", "connector_item", "connector_run"],
      "views": ["stats", "sources", "items", "runs", "config", "data", "actions"],
      "toolActions": [
        "connector.status",
        "connector.stats",
        "connector.driverList",
        "connector.sourceList",
        "connector.sourceGet",
        "connector.sourceCreate",
        "connector.sourceUpdate",
        "connector.sourceDelete",
        "connector.sourceBind",
        "connector.sourceDelivery",
        "connector.sourceRun",
        "connector.itemList",
        "connector.runList",
        "connector.dataTables",
        "connector.dataQuery",
        "connector.actionSchema"
      ],
      "client": "lib/client.js"
    }
  },
  "dependencies": {
    "dsh-workbench": "file:../../shell-dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["dsh-workbench"]
    }
  }
}
