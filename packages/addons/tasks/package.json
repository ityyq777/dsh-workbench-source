{
  "name": "dsh-workbench-tasks",
  "version": "5.2.4",
  "description": "个人工作台任务插件：任务树、标签、优先级、截止日、时间线与重启",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "shared",
    "cordis.patch.yml",
    "package.json"
  ],
  "wb": {
    "addon": {
      "id": "wb-addon-tasks",
      "title": "任务",
      "description": "任务树 + 统计/记录/时间线/工作区/配置/数据/命令/Action 八个视图：紧急/已关闭/已开启/已完成/总览，可按标签筛选，附统计报表与表数据浏览",
      "version": "5.2.4",
      "minShell": "0.6.3",
      "tables": [
        "task",
        "task_node",
        "task_timeline",
        "task_timeline_link",
        "task_workspace",
        "task_workspace_link"
      ],
      "views": [
        "stats",
        "tasks",
        "timeline",
        "workspace",
        "config",
        "data",
        "commands",
        "actions"
      ],
      "toolActions": [
        "tasks.list",
        "tasks.get",
        "tasks.create",
        "tasks.bulkUpdate",
        "tasks.bulkCreate",
        "tasks.bulkDelete",
        "tasks.update",
        "tasks.selected",
        "taskTimelines.create",
        "taskTimelines.get",
        "taskTimelines.update",
        "taskTimelines.delete",
        "taskTimelines.attach",
        "taskTimelines.detach",
        "taskTimelines.migrate",
        "taskWorkspaces.create",
        "taskWorkspaces.get",
        "taskWorkspaces.update",
        "taskWorkspaces.delete",
        "taskWorkspaces.list",
        "taskWorkspaces.attach",
        "taskWorkspaces.detach",
        "tasks.workspaces",
        "tasks.timelines",
        "tasks.timeline",
        "tasks.restart",
        "tasks.timelineRefactor",
        "tasks.migrate",
        "tasks.sweepShutdown",
        "tasks.stats",
        "tasks.statsReport",
        "tasks.activityCalendar",
        "tasks.delete",
        "tasks.complete",
        "tasks.tags",
        "taskNodes.tree",
        "taskNodes.overview",
        "taskNodes.children",
        "taskNodes.multipleChildren",
        "taskNodes.path",
        "taskNodes.create",
        "taskNodes.rename",
        "taskNodes.move",
        "taskNodes.delete",
        "tasks.history",
        "tasks.changelog",
        "tasks.export",
        "tasks.configGet",
        "tasks.configSet",
        "tasks.configReset",
        "tasks.configOptions",
        "tasks.dataTables",
        "tasks.dataQuery"
      ],
      "client": "lib/client.js"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dsh-workbench": "file:../../shell-dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-workbench"
      ]
    }
  }
}
