{
  "name": "dsh-workbench-vault",
  "version": "0.1.0",
  "description": "个人工作台凭据保险箱：加密保存密码/token，agent 只见掩码",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json"
  ],
  "license": "MIT",
  "wb": {
    "addon": {
      "id": "wb-addon-vault",
      "title": "凭据保险箱",
      "version": "0.1.0",
      "minShell": "0.6.7",
      "tables": [
        "vault_meta",
        "vault_secret"
      ],
      "views": [
        "status",
        "secrets",
        "config",
        "data",
        "actions"
      ],
      "toolActions": [
        "vault.status",
        "vault.setup",
        "vault.unlock",
        "vault.lock",
        "vault.setUnlockMode",
        "vault.changePassphrase",
        "vault.secretList",
        "vault.secretCreate",
        "vault.secretUpdate",
        "vault.secretDelete",
        "vault.secretReveal",
        "vault.rotateDeviceKey",
        "vault.dataTables",
        "vault.dataQuery",
        "vault.actionSchema"
      ],
      "client": "lib/client.js"
    }
  },
  "dependencies": {
    "dsh-workbench": "file:../../shell-dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "dsh-workbench"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
