{
  "name": "dsh-workbench-message",
  "version": "0.1.0",
  "description": "个人工作台消息插件：统一消息发送入口（子插件与 agent 共用）、未读计数、提示音与保留期清理",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "package.json"
  ],
  "wb": {
    "addon": {
      "id": "wb-addon-message",
      "title": "消息",
      "description": "统一消息入口 + 统计/收件箱/配置/数据四个视图：子插件与 agent 都能发消息，带未读计数与提示音",
      "version": "0.1.0",
      "minShell": "0.6.5",
      "tables": [
        "message"
      ],
      "views": [
        "stats",
        "inbox",
        "config",
        "data",
        "actions"
      ],
      "toolActions": [
        "message.send",
        "message.list",
        "message.unreadCount",
        "message.markRead",
        "message.stats",
        "message.configGet",
        "message.configSet",
        "message.configReset",
        "message.dataTables",
        "message.dataQuery"
      ],
      "client": "lib/client.js"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dsh-workbench": "file:../../shell-dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-workbench"
      ]
    }
  }
}
